rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid);
    }

    function hasProfile(schoolId) {
      return signedIn() && exists(userPath(schoolId));
    }

    function activeMember(schoolId) {
      return hasProfile(schoolId) &&
        get(userPath(schoolId)).data.active == true;
    }

    function role(schoolId) {
      return get(userPath(schoolId)).data.role;
    }

    function isAdmin(schoolId) {
      return activeMember(schoolId) && role(schoolId) == 'admin';
    }

    function isDirector(schoolId) {
      return activeMember(schoolId) && role(schoolId) == 'director';
    }

    function isCashier(schoolId) {
      return activeMember(schoolId) && role(schoolId) == 'cashier';
    }

    function isSecretary(schoolId) {
      return activeMember(schoolId) && role(schoolId) == 'secretary';
    }

    function isAdminEmail() {
      return signedIn() &&
        request.auth.token.email == 'controlpolytra@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    match /test/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /schools/{schoolId} {
      allow read: if activeMember(schoolId) || isAdminEmail();
      allow create: if isAdminEmail();
      allow update: if isAdmin(schoolId);
      allow delete: if isAdmin(schoolId);

      match /users/{userId} {
        allow read: if isAdmin(schoolId) || isSelf(userId);
        allow create: if isAdmin(schoolId) ||
          (isAdminEmail() && isSelf(userId) && request.resource.data.role == 'admin');
        allow update, delete: if isAdmin(schoolId);
      }

      match /sections/{sectionId} {
        allow read: if activeMember(schoolId);
        allow create, update, delete: if isAdmin(schoolId) || isDirector(schoolId);
      }

      match /classes/{classId} {
        allow read: if activeMember(schoolId);
        allow create, update, delete: if isAdmin(schoolId) || isDirector(schoolId) || isSecretary(schoolId);
      }

      match /options/{optionId} {
        allow read: if activeMember(schoolId);
        allow create, update, delete: if isAdmin(schoolId) || isDirector(schoolId) || isSecretary(schoolId);
      }

      match /students/{studentId} {
        allow read: if activeMember(schoolId);
        allow create, update: if isAdmin(schoolId) || isDirector(schoolId) || isSecretary(schoolId);
        allow delete: if isAdmin(schoolId) || isDirector(schoolId);
      }

      match /feeTypes/{feeTypeId} {
        allow read: if activeMember(schoolId);
        allow create, update, delete: if isAdmin(schoolId) || isDirector(schoolId);
      }

      match /studentCharges/{chargeId} {
        allow read: if activeMember(schoolId);
        allow create, update: if isAdmin(schoolId) || isDirector(schoolId);
        allow delete: if isAdmin(schoolId);
      }

      match /payments/{paymentId} {
        allow read: if activeMember(schoolId);
        allow create: if isAdmin(schoolId) || isDirector(schoolId) || isCashier(schoolId);
        allow update: if isAdmin(schoolId) || isDirector(schoolId) || isCashier(schoolId);
        allow delete: if false;
      }

      match /paymentAllocations/{allocationId} {
        allow read: if activeMember(schoolId);
        allow create: if isAdmin(schoolId) || isDirector(schoolId) || isCashier(schoolId);
        allow update, delete: if false;
      }

      match /receipts/{receiptId} {
        allow read: if activeMember(schoolId);
        allow create: if isAdmin(schoolId) || isDirector(schoolId) || isCashier(schoolId);
        allow update, delete: if false;
      }

      match /cashOperations/{operationId} {
        allow read: if activeMember(schoolId);
        allow create: if isAdmin(schoolId) || isDirector(schoolId) || isCashier(schoolId);
        allow update: if isAdmin(schoolId) || isDirector(schoolId);
        allow delete: if false;
      }

      match /auditLogs/{auditId} {
        allow read: if isAdmin(schoolId);
        allow create: if activeMember(schoolId);
        allow update, delete: if false;
      }
    }
  }
}
